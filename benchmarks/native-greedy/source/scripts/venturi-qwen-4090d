#!/usr/bin/env bash
# Explicit optional external-native Qwen deployment; no local installation.
set -euo pipefail
if [[ $# -eq 0 || $1 == --help || $1 == -h ]]; then
  echo "Usage: $0 {inspect|stage|generate|benchmark} [options]"
  echo "Qwen uses the attributed external NInfer/Cinference backend, not GPT-NeoX."
  echo "Example: $0 generate --prompt 'Explain CUDA graphs.' --max-new-tokens 64"
  echo "Override VENTURI_QWEN_MODEL to select an explicitly staged checkpoint."
  exit 0
fi
command=$1
shift
case "$command" in
  inspect|stage|generate|benchmark) ;;
  *) echo "Unknown command: $command" >&2; exit 2 ;;
esac
host=${VENTURI_SSH_HOST:-School_4090D}
directory=${VENTURI_QWEN_DIR:-/home/test/wangyue/venturi-work/qwen/src}
python=${VENTURI_REMOTE_PYTHON:-/home/test/wangyue/rwkv-distill-2.9b/.venv/bin/python}
model=${VENTURI_QWEN_MODEL:-/home/test/wangyue/weights-ours/qwen3_8_27b.ninfer}
runner=${VENTURI_QWEN_RUNNER:-/home/test/wangyue/venturi-work/qwen/native/venturi-qwen-runner}
printf -v directory_q '%q' "$directory"
printf -v invocation '%q ' env "PYTHONPATH=$directory/src" "VENTURI_QWEN_RUNNER=$runner" \
  "$python" -m venturi qwen "$command" "$model" "$@"
exec ssh -C -o BatchMode=yes -o ForwardAgent=no -o ConnectTimeout=20 \
  -o ConnectionAttempts=1 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 \
  "$host" "cd $directory_q && $invocation"
